    "## Generate derived daily metrics\n",
    "\n",
    "* This step processes the raw daily CHESS-SCAPE NetCDF files to generate derived threshold/percentile metrics.\n",
    "* It produces new NetCDF files for: `tasmax_99_percentile`, `tasmin_1_percentile`, `tropical_nights`, `hot_heat_days`, `heavy_rain_days`, `dry_days`, `windy_days`.\n",
    "* These files are then picked up by the chess-scape loader above when re-run, or loaded separately below.\n",
    "* **Note:** This requires the raw daily CHESS-SCAPE NetCDF files (not just the annual/seasonal aggregates).\n",
    "* This step is skipped automatically for any metric/RCP/bias combination where the output file already exists."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.process_daily_data import ClimateDataProcessor"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import xarray as xr\n",
    "\n",
    "processor = ClimateDataProcessor(conf, ensemble_member=1)\n",
    "\n",
    "base_path = Path(conf['chess_scape_netcdf_location'])\n",
    "seasons = ['annual', 'winter', 'summer']\n",
    "\n",
    "FULL_DECADE_COUNT = 6  # 1980, 2030, 2040, 2050, 2060, 2070\n",
    "\n",
    "\n",
    "def output_exists(rcp, bias, season, output_metric):\n",
    "    bias_suffix = '_bias-corrected' if bias else ''\n",
    "    season_folder = 'seasonal' if season != 'annual' else 'annual'\n",
    "    filename = f'chess-scape_rcp{rcp}{bias_suffix}_01_{output_metric}_uk_1km_{season}_19801201-20801130.nc'\n",
    "    file_path = base_path / f'data/rcp{rcp}{bias_suffix}/01/{season_folder}' / filename\n",
    "    return file_path.exists()\n",
    "\n",
    "\n",
    "def output_has_full_decades(rcp, bias, season, output_metric, n_decades=FULL_DECADE_COUNT):\n",
    "    \"\"\"Return True only if the output file exists and contains the expected number of decades.\"\"\"\n",
    "    bias_suffix = '_bias-corrected' if bias else ''\n",
    "    season_folder = 'seasonal' if season != 'annual' else 'annual'\n",
    "    filename = f'chess-scape_rcp{rcp}{bias_suffix}_01_{output_metric}_uk_1km_{season}_19801201-20801130.nc'\n",
    "    file_path = base_path / f'data/rcp{rcp}{bias_suffix}/01/{season_folder}' / filename\n",
    "    if not file_path.exists():\n",
    "        return False\n",
    "    try:\n",
    "        with xr.open_dataset(file_path) as ds:\n",
    "            return 'decade' in ds.dims and len(ds.decade) == n_decades\n",
    "    except Exception:\n",
    "        return False\n",
    "\n",
    "\n",
    "threshold_tasks = [\n",
    "    (\n",
    "        'tropical_nights',\n",
    "        'tropical_nights',\n",
    "        dict(\n",
    "            tropical_nights_enabled=True,\n",
    "            hot_days_enabled=False,\n",
    "            heavy_rain_enabled=False,\n",
    "            dry_days_enabled=False,\n",
    "            windy_days_enabled=False,\n",
    "        ),\n",
    "    ),\n",
    "    (\n",
    "        'hot_days',\n",
    "        'hot_heat_days',\n",
    "        dict(\n",
    "            tropical_nights_enabled=False,\n",
    "            hot_days_enabled=True,\n",
    "            heavy_rain_enabled=False,\n",
    "            dry_days_enabled=False,\n",
    "            windy_days_enabled=False,\n",
    "        ),\n",
    "    ),\n",
    "    (\n",
    "        'heavy_rain',\n",
    "        'heavy_rain_days',\n",
    "        dict(\n",
    "            tropical_nights_enabled=False,\n",
    "            hot_days_enabled=False,\n",
    "            heavy_rain_enabled=True,\n",
    "            dry_days_enabled=False,\n",
    "            windy_days_enabled=False,\n",
    "        ),\n",
    "    ),\n",
    "    (\n",
    "        'dry_days',\n",
    "        'dry_days',\n",
    "        dict(\n",
    "            tropical_nights_enabled=False,\n",
    "            hot_days_enabled=False,\n",
    "            heavy_rain_enabled=False,\n",
    "            dry_days_enabled=True,\n",
    "            windy_days_enabled=False,\n",
    "        ),\n",
    "    ),\n",
    "    (\n",
    "        'windy_days',\n",
    "        'windy_days',\n",
    "        dict(\n",
    "            tropical_nights_enabled=False,\n",
    "            hot_days_enabled=False,\n",
    "            heavy_rain_enabled=False,\n",
    "            dry_days_enabled=False,\n",
    "            windy_days_enabled=True,\n",
    "        ),\n",
    "    ),\n",
    "]\n",
    "\n",
    "missing_runs = []\n",
    "\n",
    "for rcp in [60, 85]:\n",
    "    for bias in [True, False]:\n",
    "        # Quantiles are generated together.\n",
    "        missing_quantile_seasons = [\n",
    "            season\n",
    "            for season in seasons\n",
    "            if (\n",
    "                not output_exists(rcp, bias, season, 'tasmax_99_percentile')\n",
    "                or not output_exists(rcp, bias, season, 'tasmin_1_percentile')\n",
    "            )\n",
    "        ]\n",
    "        if missing_quantile_seasons:\n",
    "            missing_runs.append(\n",
    "                dict(\n",
    "                    label='quantiles',\n",
    "                    rcp=rcp,\n",
    "                    bias=bias,\n",
    "                    seasons=missing_quantile_seasons,\n",
    "                    quantiles_config=None,\n",
    "                    kwargs=dict(\n",
    "                        tropical_nights_enabled=False,\n",
    "                        hot_days_enabled=False,\n",
    "                        heavy_rain_enabled=False,\n",
    "                        dry_days_enabled=False,\n",
    "                        windy_days_enabled=False,\n",
    "                    ),\n",
    "                )\n",
    "            )\n",
    "\n",
    "        for label, output_metric, kwargs in threshold_tasks:\n",
    "            # Use output_has_full_decades to catch files previously generated with only 2 decades\n",
    "            missing_metric_seasons = [\n",
    "                season\n",
    "                for season in seasons\n",
    "                if not output_has_full_decades(rcp, bias, season, output_metric)\n",
    "            ]\n",
    "            if missing_metric_seasons:\n",
    "                missing_runs.append(\n",
    "                    dict(\n",
    "                        label=label,\n",
    "                        rcp=rcp,\n",
    "                        bias=bias,\n",
    "                        seasons=missing_metric_seasons,\n",
    "                        quantiles_config={},\n",
    "                        kwargs=kwargs,\n",
    "                    )\n",
    "                )\n",
    "\n",
    "if not missing_runs:\n",
    "    print('No missing metric combinations found.')\n",
    "else:\n",
    "    print(f'Found {len(missing_runs)} missing generation run(s).')\n",
    "\n",
    "    for run in missing_runs:\n",
    "        bias_label = 'bias-corrected' if run['bias'] else 'non-bias'\n",
    "        print(f\"\\nGenerating {run['label']} | RCP{run['rcp']} | {bias_label} | seasons={run['seasons']}\")\n",
    "        start = time.time()\n",
    "        try:\n",
    "            processor.generate_data(\n",
    "                quantiles_config=run['quantiles_config'],\n",
    "                seasons=run['seasons'],\n",
    "                rcps=[run['rcp']],\n",
    "                bias_options=[run['bias']],\n",
    "                **run['kwargs'],\n",
    "            )\n",
    "            print(f\"  OK ({(time.time() - start) / 60:.1f} min)\")\n",
    "        except Exception as e:\n",
    "            print(f\"  FAILED: {str(e)[:200]}\")\n"
   ]
  },
